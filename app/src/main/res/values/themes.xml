<resources>
  <color name="rise_bg">#000000</color>
  <style name="Theme.Rise" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/rise_bg</item>
  </style>
  <style name="Theme.Rise.Splash" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/rise_bg</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="windowSplashScreenIconBackgroundColor">@color/rise_bg</item>
    <item name="postSplashScreenTheme">@style/Theme.Rise</item>
  </style>
</resources>
